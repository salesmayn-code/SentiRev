{
  "name": "sentirev",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.9.3"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:security": "vitest run tests/security tests/unit/auth tests/unit/github --passWithNoTests",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "design:lint": "designmd lint DESIGN.md",
    "secrets:check": "vitest run tests/security/secret-scan.test.ts",
    "worker": "tsx worker/foundation-worker.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@prisma/client": "6.12.0",
    "bullmq": "5.81.4",
    "ioredis": "5.11.1",
    "next": "15.5.25",
    "postcss": "8.5.23",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "0.35.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.25",
    "playwright": "1.62.1",
    "prisma": "6.12.0",
    "smee-client": "5.0.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
